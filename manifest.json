{
  "manifest_version": 3,
  "name": "FocusQuota",
  "version": "1.0.0",
  "description": "A gentle daily quota for casual browsing — reminds, never blocks.",
  "permissions": [
    "storage",
    "tabs",
    "alarms",
    "notifications",
    "idle"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "FocusQuota",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}