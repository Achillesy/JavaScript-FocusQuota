{
  "manifest_version": 3,
  "name": "FocusQuota",
  "version": "1.1.1",
  "default_locale": "en",
  "description": "__MSG_appDescription__",
  "permissions": [
    "storage",
    "tabs",
    "alarms",
    "notifications",
    "idle"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "__MSG_appName__",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}